{
  "name": "qa-avatar-command",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "setup": "npm install && npm run build",
    "build": "vite build && vite build -c vite.server.config.ts",
    "start": "node --env-file-if-exists=.env dist/server/index.mjs",
    "test": "node scripts/test-lifecycle.mjs && node scripts/test-case-titles.mjs && node scripts/test-document-name.mjs && node scripts/test-excel-export.mjs && node scripts/test-cloudflare-auth.mjs",
    "typecheck": "tsc --noEmit",
    "test:review-api": "npm run build && node scripts/test-review-api.mjs",
    "build:cloudflare": "vite build && vite build -c vite.cloudflare.config.ts",
    "deploy:cloudflare": "npm run build:cloudflare && wrangler deploy",
    "dev:cloudflare": "npm run build:cloudflare && wrangler dev"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@hookform/resolvers": "^5.7.1",
    "@shadcn/react": "^0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "exceljs": "^4.4.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.31.0",
    "mammoth": "^1.13.0",
    "next-themes": "^0.4.6",
    "pdfjs-dist": "^6.3.289",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.6",
    "react-hook-form": "^7.85.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.8.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "vaul": "^1.1.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "eslint": "9.39.4",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "wrangler": "^4.152.0"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.0"
    }
  }
}
