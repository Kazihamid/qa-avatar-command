{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "types": [
      "node",
      "vite/client"
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "app",
    "components",
    "hooks",
    "lib",
    "local",
    "server",
    "src",
    "vite.config.ts",
    "vite.server.config.ts",
    "cloudflare",
    "vite.cloudflare.config.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
