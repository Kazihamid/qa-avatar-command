# Optional settings. Copy this file to ".env" in this same folder, remove the leading # on the lines you need, then restart the app.
# Never paste keys or tokens into chat or screenshots.

# --- Local agent connection (Execution tab) ---
# Where your Autonomous QA Execution Agent control plane listens. Must be a local address.
# QA_AGENT_CONTROL_PLANE_URL=http://localhost:8080
# If your agent uses the default development sign-in you need nothing else. If you changed it, use the SAME identity as the agent's login page:
# QA_AGENT_DEV_SUB=dev-user-001
# QA_AGENT_DEV_EMAIL=qa.engineer@example.invalid
# QA_AGENT_DEV_NAME=QA Engineer
# If the agent uses real authentication, supply a token instead (it is never saved by this app):
# QA_AGENT_BEARER_TOKEN=

# --- AI Review (optional, needs an OpenAI API account with credit) ---
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini

# --- App port (default 4177) ---
# PORT=4177

# --- Codex execution companion ---
# Run codex login once. Use your existing Codex account and its usage allowance.
# Set this to your QA Avatar Command address.
# QA_AVATAR_URL=https://qa-avatar-command.kazihamidur.workers.dev
# QA_AVATAR_USER=qa-admin
# Enter the current QA Avatar admin password locally. Do not commit .env.
# QA_AVATAR_PASSWORD=
# Optional. Restrict this companion to one project ID.
# QA_CODEX_PROJECT_ID=
# Optional. Browser login state saved on this computer with Playwright codegen.
# QA_CODEX_STORAGE_STATE=data/codex-auth.json
# Optional. Full path to codex.exe if Codex is absent from PATH.
# QA_CODEX_COMMAND=
